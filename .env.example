# MonarcaDB (proyecto Supabase: ldjuyocsuvvvbllgdclv).
# Configuración Session pooler confirmada en Supabase > Connect.
# Usar puerto 5432; 6543 corresponde al pooler de transacciones.
# El esquema de aplicación es "monarca" y la base PostgreSQL se llama "postgres".
# No publiques este archivo con una contraseña real.
DB_URL='jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require'
DB_USERNAME='postgres.ldjuyocsuvvvbllgdclv'
DB_PASSWORD='REEMPLAZA_CON_TU_PASSWORD_DE_DATABASE'
JWT_SECRET='REEMPLAZA_CON_32_BYTES_ALEATORIOS_O_MAS'
DB_POOL_MAX_SIZE=5
JPA_SHOW_SQL=false

# Frontends autorizados a llamar la API desde el navegador (separados por coma).
# No incluyas '/' al final. Agrega previews de Vercel solo si los necesitas.
CORS_ALLOWED_ORIGINS='http://localhost:4200,http://127.0.0.1:4200,https://monarca-front.vercel.app,https://nayelismoda.shop,https://www.nayelismoda.shop'

# Recuperación de contraseña con Spring Email + Resend SMTP.
# Crear API Key privada en https://resend.com/api-keys (no usar Google App Password).
# Verificar tu dominio remitente en https://resend.com/domains.
# MAIL_FROM debe pertenecer al dominio verificado. Nunca subir la API Key a Git.
MAIL_HOST='smtp.resend.com'
MAIL_PORT=587
MAIL_USERNAME='resend'
MAIL_PASSWORD=''
MAIL_FROM=''
# Opcional: destinatario administrativo. Si está vacío, usar cuentas ADMIN activas en DB.
MAIL_ADMIN_TO=''
# URL a mostrar en los correos de seguimiento (local para pruebas).
SHOP_PUBLIC_URL='http://localhost:4200'
# Local: Angular. Producción: https://nayelismoda.shop/login
PASSWORD_RESET_URL='http://localhost:4200/login'

# Solo para el probador virtual de pruebas (API de TryOn Labs).
# Tras registrarte en https://playground.tryonlabs.ai obtén tu access token.
# Déjalo vacío si aún no tienes créditos/token. Nunca lo pongas en el frontend.
TRYONLABS_TOKEN=''

# Ajustes económicos por defecto para pruebas. Validar consumo real en el proveedor.
TRYON_RESOLUTION='1k'
TRYON_GENERATION_MODE='fast'

# Nuevo probador: https://agalaz.com/developers (50 llamadas gratuitas durante 7 días).
# Crea tu cuenta en /partners, registra el dominio de prueba y guarda la clave solo aquí.
TRYON_PROVIDER='tryoncloud'
AGALAZ_API_KEY=''

# Recomendado: 10 generaciones gratuitas sin tarjeta en https://www.tryoncloud.com/signup
# Dashboard > Developer API > Create key (prefijo tk_dev_v1_).
TRYONCLOUD_API_KEY=''

# SOLO backend: clave privada service_role del proyecto MonarcaDB.
# Necesaria también para subir evidencias de pago al bucket PRIVADO.
# Si queda vacía, POST /api/pedidos/{id}/evidencia devuelve HTTP 503.
# En IntelliJ configúrala en Run > Edit Configurations > Environment variables.
# Al ejecutar desde terminal, exporta este .env (set -a; source .env; set +a).
# NUNCA mostrar, compartir, subir a Git ni poner la clave en Angular.
MONARCA_SUPABASE_URL='https://ldjuyocsuvvvbllgdclv.supabase.co'
MONARCA_STORAGE_BUCKET='monarca-productos'
MONARCA_EVIDENCIAS_BUCKET='monarca-evidencias-pago'
SUPABASE_SERVICE_ROLE_KEY=''

# ID público OAuth Web Application de Google Cloud (no Client Secret).
GOOGLE_WEB_CLIENT_ID=
